# ==============================================================================
# Gemuse - Environment Configuration Template
# Copy this file to `.env` and fill in secure values before starting.
# NEVER commit `.env` to version control.
# ==============================================================================

# --- Application ---
APP_NAME=Gemuse
APP_ENV=production
LOG_LEVEL=INFO
APP_HOST=127.0.0.1
APP_PORT=8000
BACKEND_PORT=8005
CORS_ORIGINS=https://gemuse.zyuuuukak1n.dev,https://gemini.google.com,http://localhost:3000

# --- Security & Authentication ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_SECRET_TOKEN=change-me-use-a-long-random-secret-token-here
# HMAC-SHA256 secret for one-time Human-in-the-loop approval tokens
APPROVAL_HMAC_SECRET=change-me-use-another-long-random-hmac-secret
APPROVAL_TOKEN_TTL_SECONDS=600
# Dedicated token for Chrome bookmarklet / official Gemini one-click ingest (X-Gemuse-Ingest-Token)
GEMUSE_INGEST_TOKEN=

# Cloudflare Access JWT Verification (Optional; set true when behind CF Access)
CF_ACCESS_ENABLED=false
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUD=your-cloudflare-access-aud-tag

# --- Gemini 4 Hydrogen API ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-4-hydrogen
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_TIMEOUT_SECONDS=120

# --- PostgreSQL + pgvector ---
POSTGRES_USER=gemuse
POSTGRES_PASSWORD=change-me-strong-postgres-password
POSTGRES_DB=gemuse
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://gemuse:change-me-strong-postgres-password@postgres:5432/gemuse

# --- Redis & ARQ Worker ---
REDIS_PASSWORD=change-me-strong-redis-password
REDIS_URL=redis://:change-me-strong-redis-password@redis:6379/0
ARQ_MAX_JOBS=10
ARQ_JOB_TIMEOUT_SECONDS=600

# --- Memory & File Paths ---
CORE_MEMORY_PATH=/app/data/core_memory.md
SHARED_FILES_DIR=/shared_files
CONFIG_DIR=/app/config
MEMORY_SIMILARITY_THRESHOLD=0.55
MEMORY_TOP_K=5
MCP_TOOL_TIMEOUT_SECONDS=15.0

# --- Step 2: Discord Multi-Server Integration ---
DISCORD_BOT_TOKEN=
DISCORD_API_BASE_URL=https://discord.com/api/v10

# --- Step 2: Multi-Mail Integration (Outlook / iCloud / Gmail) ---
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT_ID=
OUTLOOK_REFRESH_TOKEN=

ICLOUD_EMAIL=
ICLOUD_APP_PASSWORD=
ICLOUD_IMAP_HOST=imap.mail.me.com
ICLOUD_IMAP_PORT=993
ICLOUD_SMTP_HOST=smtp.mail.me.com
ICLOUD_SMTP_PORT=587

# --- Step 2: Google Workspace (Gmail / Calendar / Drive) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# --- Step 2: Social & Media (X / YouTube) ---
X_BEARER_TOKEN=
X_USER_ID=
YOUTUBE_API_KEY=
YOUTUBE_OAUTH_REFRESH_TOKEN=

# --- Step 3: Isolated Browser Sandbox & noVNC ---
BROWSER_SANDBOX_URL=http://browser:7000
BROWSER_NOVNC_URL=http://browser:6080
NOVNC_PASSWORD=
SHARED_FILES_DIR=/shared_files
BROWSER_ARTIFACT_TTL_SECONDS=86400

# --- Step 3: Proactive Notifications & Web Push ---
PROACTIVE_RULES_PATH=/app/config/proactive_rules.yaml
PROACTIVE_TIMEZONE=Asia/Tokyo
DISCORD_NOTIFY_WEBHOOK_URL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:admin@example.com

# --- Step 3: Twilio Voice Bridge & Gemini Live API ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
PUBLIC_BASE_URL=https://gemuse.example.com
GEMINI_LIVE_MODEL=gemini-4-hydrogen-live

# --- Step 4: Next.js PWA Frontend & BFF ---
FRONTEND_PORT=3005
BACKEND_INTERNAL_URL=http://backend:8000
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NEXT_PUBLIC_APP_DOMAIN=https://gemuse.zyuuuukak1n.dev
